# Hailo-15 6.18 kernel config fragment (porting verification build)
# Base: 6.18 arm64 defconfig + Hailo-15 options.
# Options mirror meta-hailo-soc 1.12.1 defconfig Hailo entries, kept buildable
# on 6.18 (CMA_DEBUGFS rework, SCMI Hailo protocol, etc.).
CONFIG_ARCH_HAILO15=y
CONFIG_ARM64_AC57=y

# Firmware / SCMI
CONFIG_ARM_SCMI_PROTOCOL=y
CONFIG_ARM_SCMI_CPUFREQ=y
CONFIG_SENSORS_ARM_SCMI=y
CONFIG_COMMON_CLK_SCMI=y
CONFIG_ARM_SCMI_TRANSPORT_SMC=y
CONFIG_HAILO_SCMI_PROTOCOL=y

# SoC / pinctrl / PWM
CONFIG_SOC_HAILO=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_HAILO15=y
CONFIG_PWM=y
CONFIG_PWM_HAILO15=y

# DMA / CMA
CONFIG_DMADEVICES=y
CONFIG_HAILO15_GP_VDMA=y
CONFIG_HAILO15_GP_MEMCOPY=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_DMABUF_SYSFS_STATS=y
CONFIG_DMA_CMA=y
CONFIG_CMA=y
CONFIG_CMA_SIZE_MBYTES=32

# GPU / DRM
CONFIG_DRM=y
CONFIG_DRM_HAILO=y

# USB
CONFIG_USB=y
CONFIG_USB_CDNS3=y
CONFIG_USB_CDNS3_HAILO=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_F_HAILO_RFS_LOAD=m
CONFIG_USB_F_HAILO_SWU_LOAD=m
CONFIG_USB_HAILO_GADGET=m

# EDAC
CONFIG_EDAC=y
CONFIG_EDAC_HAILO15_CDNS=y

# PERF
CONFIG_HAILO_NOC_PMU=y

# misc: hailo15-evb-cpld builds under ARCH_HAILO15 (no dedicated Kconfig option in 1.12.1)
