config DRM_HAILO
	tristate "HAILO Display"
	depends on DRM
	select DRM_KMS_HELPER
	# 6.18: KMS CMA helper renamed KMS_CMA->GEM_DMA
	select DRM_GEM_DMA_HELPER
	help
	  This is a DRM display driver for HAILO Displays or display
	  adapters.

	  If M is selected the module will be called hailo.
