/dts-v1/;
/ {
    description = "Kernel fitImage for Hailo-15 / 6.18.52 / public EVB";
    #address-cells = <1>;

    images {
        kernel-1 {
            description = "Linux 6.18.52 MACB (Hailo GEM port)";
            data = /incbin/("kernel.gz");
            type = "kernel";
            arch = "arm64";
            os = "linux";
            compression = "gzip";
            load = <0x80c00000>;
            entry = <0x80c00000>;
            hash-1 {
                algo = "sha256";
                checksum = "yes";
            };
        };

        fdt-evb.dtb {
            description = "Hailo-15 EVB 2-camera VPU device tree (public Hailo dts)";
            data = /incbin/("board.dtb");
            type = "flat_dt";
            arch = "arm64";
            compression = "none";
            load = <0x80800000>;
            hash-1 {
                algo = "sha256";
                checksum = "yes";
            };
        };
    };

    configurations {
        default = "conf-evb.dtb";

        conf-evb.dtb {
            description = "6.18 + public Hailo-15 EVB dtb";
            kernel = "kernel-1";
            fdt = "fdt-evb.dtb";
            hash-1 {
                algo = "sha256";
                checksum = "yes";
            };
        };
    };
};
